{
  "type": "minecraft:condition",
  "if_true": {
    "type": "minecraft:biome",
    "biome_is": "newmeriacore:black_desert"
  },
  "then_run": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": "minecraft:on_floor",
        "then_run": {
          "type": "minecraft:condition",
          "if_true": "minecraft:not_underwater",
          "then_run": "newmeriacore:black_sand_or_sandstone_if_ceiling"
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": "minecraft:not_under_deep_water",
        "then_run": {
          "type": "minecraft:sequence",
          "sequence": [
            {
              "type": "minecraft:condition",
              "if_true": "minecraft:under_floor",
              "then_run": "newmeriacore:black_sand_or_sandstone_if_ceiling"
            },
            {
              "type": "minecraft:condition",
              "if_true": "minecraft:very_deep_under_floor",
              "then_run": {
                "type": "minecraft:block",
                "result_state": "newmeriacore:black_sandstone"
              }
            }
          ]
        }
      }
    ]
  }
}
